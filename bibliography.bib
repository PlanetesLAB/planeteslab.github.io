@article{tumlinsonCircumgalacticMedium2017,
  title = {The {{Circumgalactic Medium}}},
  author = {Tumlinson, Jason and Peeples, Molly S. and Werk, Jessica K.},
  year = 2017,
  month = aug,
  journal = {Annual Review of Astronomy and Astrophysics},
  volume = {55},
  number = {1},
  eprint = {1709.09180},
  primaryclass = {astro-ph},
  pages = {389--432},
  issn = {0066-4146, 1545-4282},
  doi = {10.1146/annurev-astro-091916-055240},
  urldate = {2022-06-01},
  abstract = {The gas surrounding galaxies outside their disks or ISM and inside their virial radii is known as the ``circumgalactic medium'' (CGM). In recent years this component of galaxies has assumed an important role in our understanding of galaxy evolution owing to rapid advances in observational access to this diffuse, nearly invisible material. Observations and simulations of this component of galaxies suggest that it is a multiphase medium characterized by rich dynamics and complex ionization states. The CGM is a source for a galaxy's star-forming fuel, the venue for galactic feedback and recycling, and perhaps the key regulator of the galactic gas supply. We review our evolving knowledge of the CGM with emphasis on its mass, dynamical state, and co-evolution with galaxies. Observations from all redshifts and from across the electromagnetic spectrum indicate that CGM gas has a key role in galaxy evolution. We summarize the state of this field and pose unanswered questions for future research.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Astrophysics - Astrophysics of Galaxies}
}

