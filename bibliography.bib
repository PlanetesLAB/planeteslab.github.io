@misc{xieWaterRichDisksLate2023,
  title = {Water-{{Rich Disks}} around {{Late M-stars Unveiled}}: {{Exploring}} the {{Remarkable Case}} of {{Sz114}}},
  shorttitle = {Water-{{Rich Disks}} around {{Late M-stars Unveiled}}},
  author = {Xie, Chengyan and Pascucci, Ilaria and Long, Feng and Pontoppidan, Klaus M. and Banzatti, Andrea and Kalyaan, Anusha and Salyk, Colette and Liu, Yao and Najita, Joan R. and Pinilla, Paola and Arulanantham, Nicole and Herczerg, Gregory J. and Carr, John and Bergin, Edwin A. and Ballering, Nicholas P. and Krijt, Sebastiaan and Blake, Geoffrey A. and Zhang, Ke and Oberg, Karin I. and Green, Joel D. and {collaboration}, the JDISC},
  year = 2023,
  month = oct,
  number = {arXiv:2310.13205},
  eprint = {2310.13205},
  primaryclass = {astro-ph},
  publisher = {arXiv},
  urldate = {2023-10-23},
  abstract = {We present an analysis of the JWST/MIRI-MRS spectrum of Sz114, an accreting M5 star surrounded by a large dust disk with a gap at \textasciitilde 39au. The spectrum is molecular-rich: we report the detection of water, CO, CO2, HCN, C2H2, and H2. The only identified atomic/ionic transition is from [NeII] at 12.81 micron. A distinct feature of this spectrum is the forest of water lines with the 17.22 micron emission surpassing that of most late M-star disks by an order of magnitude in flux and aligning instead with disks of earlier-type stars. Moreover, flux rations of C2H2/H2O and HCN/H2O in Sz114 also resemble those of earlier-type disks, with a slightly elevated CO2/H2O ratio. While accretion heating can boost all infrared lines, the unusual properties of Sz114 could be explained by the young age of the source, its formation under unusual initial conditions (a large massive disk), and/or the presence of dust substructures. The latter delay the inward drift of icy pebbles and thus preserve a lower C/O ratio over an extended period. In contrast, late M-star disks-which are typically faint, small in size, and likely lack significant substructures-may have more quickly depleted the outer icy reservoir and already evolved out of a water-rich inner disk phase. Our findings underscore the unexpected diversity within mid-infrared spectra of late M-star disks, highlighting the need to expand the observational sample for a comprehensive understanding of their variations and thoroughly test pebble drift and planet formation models.},
  archiveprefix = {arXiv},
  keywords = {Astrophysics - Earth and Planetary Astrophysics,Astrophysics - Solar and Stellar Astrophysics},
  file = {/Users/kmaitreys/Zotero/storage/VCHK5THM/Xie et al. - 2023 - Water-Rich Disks around Late M-stars Unveiled Exp.pdf;/Users/kmaitreys/Zotero/storage/TBEYXWU6/2310.html}
}

