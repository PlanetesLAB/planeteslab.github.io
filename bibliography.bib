@article{platenAlignmentVoidsCosmic2008,
  title = {Alignment of Voids in the Cosmic Web},
  author = {Platen, Erwin and {van de Weygaert}, Rien and Jones, Bernard J. T.},
  year = 2008,
  month = jun,
  journal = {Monthly Notices of the Royal Astronomical Society},
  volume = {387},
  number = {1},
  pages = {128--136},
  issn = {0035-8711, 1365-2966},
  doi = {10.1111/j.1365-2966.2008.13019.x},
  urldate = {2022-08-25},
  abstract = {We investigate the shapes and mutual alignment of voids in the large-scale matter distribution of a cold dark matter ( CDM) cosmology simulation. The voids are identified using the novel watershed void finder (WVF) technique. The identified voids are quite non-spherical and slightly prolate, with axis ratios in the order of c : b : a {$\approx$} 0.5 : 0.7 : 1. Their orientations are strongly correlated with significant alignments spanning scales {$>$}30 h-1 Mpc.},
  langid = {english},
  keywords = {Astrophysics,cosmology: theory,large-scale structure of Universe,methods: data analysis,methods: numerical}
}

