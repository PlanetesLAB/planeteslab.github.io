@article{batyginSelfConsistentModelDustGas2022,
  title = {A {{Self-Consistent Model}} for {{Dust-Gas Coupling}} in {{Protoplanetary Disks}}},
  author = {Batygin, Konstantin and Morbidelli, Alessandro},
  year = 2022,
  month = oct,
  journal = {Astronomy \& Astrophysics},
  volume = {666},
  eprint = {2204.03700},
  primaryclass = {astro-ph},
  pages = {A19},
  issn = {0004-6361, 1432-0746},
  doi = {10.1051/0004-6361/202243196},
  urldate = {2024-04-20},
  abstract = {Various physical processes that ensue within protoplanetary disks -- including vertical settling of icy/rocky grains, radial drift of solids, planetesimal formation, as well as planetary accretion itself -- are facilitated by hydrodynamic interactions between H/He gas and high-\$Z\$ dust. The Stokes number, which quantifies the strength of dust-gas coupling, thus plays a central role in protoplanetary disk evolution, and its poor determination constitutes an important source of uncertainty within the theory of planet formation. In this work, we present a simple model for dust-gas coupling, and demonstrate that for a specified combination of the nebular accretion rate, \$\textbackslash dot\textbraceleft M\textbraceright\$, and turbulence parameter, \$\textbackslash alpha\$, the radial profile of the Stokes number can be calculated uniquely. Our model indicates that the Stokes number grows sub-linearly with orbital radius, but increases dramatically across the water-ice line. For fiducial protoplanetary disk parameters of \$\textbackslash dot\textbraceleft M\textbraceright =10\textasciicircum\textbraceleft -8\textbraceright\textbackslash,M\_\textbraceleft\textbackslash odot\textbraceright/\$year and \$\textbackslash alpha=10\textasciicircum\textbraceleft -3\textbraceright\$, our theory yields characteristic values of the Stokes number on the order of \$\textbackslash mathrm\textbraceleft St\textbraceright\textbackslash sim10\textasciicircum\textbraceleft -4\textbraceright\$ (corresponding to \$\textbackslash sim\$mm-sized silicate dust) in the inner nebula and \$\textbackslash mathrm\textbraceleft St\textbraceright\textbackslash sim10\textasciicircum\textbraceleft -1\textbraceright\$ (corresponding to \$\textbackslash sim\$few-cm-sized icy grains), in the outer regions of the disk. Accordingly, solids are expected to settle into a thin sub-disk at large stellocentric distances, while remaining vertically well-mixed inside the ice line.},
  archiveprefix = {arXiv},
  keywords = {Astrophysics - Earth and Planetary Astrophysics,Astrophysics - Solar and Stellar Astrophysics},
  file = {/Users/kmaitreys/Zotero/storage/SNKTWPFQ/Batygin and Morbidelli - 2022 - A Self-Consistent Model for Dust-Gas Coupling in P.pdf;/Users/kmaitreys/Zotero/storage/BBFH5MSY/2204.html}
}

@article{baudisDarkMatterDetection2016,
  title = {Dark Matter Detection},
  author = {Baudis, Laura},
  year = 2016,
  month = feb,
  journal = {Journal of Physics G: Nuclear and Particle Physics},
  volume = {43},
  number = {4},
  pages = {044001},
  publisher = {IOP Publishing},
  issn = {0954-3899},
  doi = {10.1088/0954-3899/43/4/044001},
  urldate = {2023-11-27},
  abstract = {More than 80 years after its first postulation in modern form, the existence and distribution of dark matter in our Universe is well established. Dark matter is the gravitational glue that holds together galaxies, galaxy clusters and structures on the largest cosmological scales, and an essential component to explain the observed fluctuations in the cosmic microwave background. Yet its existence is inferred indirectly, through its gravitational influence on luminous matter, and its nature is not known. A viable hypothesis is that dark matter is made of new, elementary particles, with allowed masses and interaction strengths spanning a wide range. Two well-motivated classes of candidates are axions and weakly interacting massive particles (WIMPs), and experimental efforts have now reached sensitivities that allow them to test this hypothesis. Axions, produced non-thermally in the early Universe, can be detected by exploiting their predicted couplings to photons and electrons. WIMPs can be detected directly by looking for their collisions with atomic nuclei ultra-low background detectors, or indirectly, through the observation of their annihilation products such as neutrinos, gamma rays, positrons and antiprotons over the astrophysical background. A complementary method is the production of dark matter particles at colliders such as the Large Hadron Collider, where they could be observed indirectly via missing transverse energy, or via associated particle production. I will review the main experimental efforts to search for dark matter particles, and the existing constraints on the interaction cross sections. I will also discuss future experiments, their complementarity and their ability to measure the properties of these particles.},
  langid = {english},
  file = {/Users/kmaitreys/Zotero/storage/4MJJYGWF/Baudis - 2016 - Dark matter detection.pdf}
}

