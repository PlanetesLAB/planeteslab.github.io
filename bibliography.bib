@article{arltThreedimensionalStabilitySolar2005,
  title = {Three-Dimensional Stability of the Solar Tachocline},
  author = {Arlt, R. and Sule, A. and R{\"u}diger, G.},
  year = 2005,
  month = oct,
  journal = {Astronomy \& Astrophysics},
  volume = {441},
  number = {3},
  pages = {1171--1175},
  issn = {0004-6361, 1432-0746},
  doi = {10.1051/0004-6361:20052928},
  urldate = {2022-06-22},
  abstract = {The three-dimensional, hydrodynamic stability of the solar tachocline was investigated based on a rotation profile as a function of both latitude and radius. By varying the amplitude of the latitudinal differential rotation, we found linear stability limits at various Reynolds numbers by numerical computations. We repeated the computations with different latitudinal and radial dependences of the angular velocity. The stability limits are all higher than those previously found from two-dimensional approximations and higher than the shear expected in the Sun. It is concluded that any part of the tachocline which is radiative is hydrodynamically stable against small perturbations.},
  langid = {english}
}

