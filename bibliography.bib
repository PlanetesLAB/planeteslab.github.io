@article{shethHierarchyVoidsMuch2004,
  title = {A Hierarchy of Voids: Much Ado about Nothing},
  shorttitle = {A Hierarchy of Voids},
  author = {Sheth, Ravi K. and {van de Weygaert}, Rien},
  year = 2004,
  month = may,
  journal = {Monthly Notices of the Royal Astronomical Society},
  volume = {350},
  number = {2},
  pages = {517--538},
  issn = {00358711, 13652966},
  doi = {10.1111/j.1365-2966.2004.07661.x},
  urldate = {2022-11-21},
  abstract = {We present a model for the distribution of void sizes and its evolution in the context of hierarchical scenarios of gravitational structure formation. We find that at any cosmic epoch the voids have a size distribution that is well-peaked about a characteristic void size that evolves self-similarly in time. This is in distinct contrast to the distribution of virialized halo masses, which does not have a small-scale cut-off.},
  langid = {english}
}

