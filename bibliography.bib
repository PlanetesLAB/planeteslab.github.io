  abstract = {The distribution of galaxies on scales larger than \textasciitilde{} 10 1 Mpc seems to be characterized by large voids, (20-40) h\textasciitilde x Mpc in diameter and of amplitude 8 \textasciitilde{} --- (0.7-0.8). It was previously argued that the mere existence of such voids poses a severe problem to all dissipationless clustering theories. Here we show that the voids may, in fact, be a natural outcome of a dissipationless clustering scenario if both adiabatic and isothermal density perturbations exist primordially. When the nonlinear evolution of spherical voids of this type is followed for adiabatic perturbations with an index n{$>$} --- 1, it is seen that they become surrounded by a shell of positive density contrast. Their structure is insensitive to Q{$>$}0 while their dynamics is quite sensitive to it. The maximum peculiar velocity (relative to Hubble flow) within the void is found to be: vp/vH \textasciitilde{} (0.4-0.5) for = 1.0, \textasciitilde{} (0.2-0.25) for \pounds 20 = 0.45, and {$<$} 0.09 for ti0 = 0.\textbackslash.},
  langid = {english},
  file = {/Users/kmaitreys/Zotero/storage/C6JGNZZM/Hoffman and Shaham - 1982 - On the origin of the voids in the galaxy distribut.pdf}
}

