@article{dekelOmegaVelocitiesVoids1994,
  title = {Omega from {{Velocities}} in {{Voids}}},
  author = {Dekel, Avishai and Rees, Martin},
  year = 1994,
  month = feb,
  journal = {The Astrophysical Journal},
  volume = {422},
  eprint = {astro-ph/9308029},
  pages = {L1},
  issn = {0004-637X, 1538-4357},
  doi = {10.1086/187197},
  urldate = {2022-08-25},
  abstract = {We propose a method for deriving a dynamical lower bound on \$\textbackslash Omega\$ from diverging flows in low-density regions, based on the fact that large outflows are not expected in a low-\$\textbackslash Omega\$ universe. The velocities are assumed to be induced by gravity from small initial fluctuations, but no assumptions are made regarding their exact Gaussian nature, galaxy biasing, or \$\textbackslash Lambda\$. The derivatives of a diverging velocity field infer a nonlinear approximation to the mass density, which is an overestimate when the true value of \$\textbackslash Omega\$ is assumed. This inferred density can become ridiculously negative when the assumed \$\textbackslash Omega\$ is too low, thus bounding \$\textbackslash Omega\$. Observed radial peculiar velocities of galaxies allow the \textbackslash pot\textbackslash{} procedure to recover the required velocity field, Gaussian smoothed at \$1200\textbackslash kms\$. The density and the associated errors are then inferred for different values of \$\textbackslash Omega\$, searching for a void which shows negative inferred density with high confidence. A preliminary application to data in a southern void indicates that \$\textbackslash Omega\textbackslash leq 0.3\$ can be ruled out at the \$2.4\$-sigma level. A detailed study of possible systematic errors is under way.},
  archiveprefix = {arXiv},
  keywords = {Applications Of Mathematics,Astrophysics,Cosmology,COSMOLOGY: DARK MATTER,COSMOLOGY: LARGE-SCALE STRUCTURE OF UNIVERSE,COSMOLOGY: THEORY,Dark Matter,Galactic Clusters,Galactic Evolution,Galaxies,GALAXIES: CLUSTERING,GALAXIES: FORMATION,Gravitation,GRAVITATION,Integrals,Nonlinearity,Numerical Analysis,Random Errors}
}

