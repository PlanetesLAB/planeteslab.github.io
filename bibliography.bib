@article{veronesiDynamicalMeasurementDisk2021,
  title = {A {{Dynamical Measurement}} of the {{Disk Mass}} in {{Elias}} 2--27},
  author = {Veronesi, Benedetta and {Paneque-Carre{\~n}o}, Teresa and Lodato, Giuseppe and Testi, Leonardo and P{\'e}rez, Laura M. and Bertin, Giuseppe and Hall, Cassandra},
  year = 2021,
  month = jun,
  journal = {The Astrophysical Journal Letters},
  volume = {914},
  number = {2},
  pages = {L27},
  publisher = {The American Astronomical Society},
  issn = {2041-8205},
  doi = {10.3847/2041-8213/abfe6a},
  urldate = {2026-09-28},
  abstract = {Recent multi-wavelength Atacama Large Millimeter/submillimeter Array (ALMA) observations of the protoplanetary disk orbiting around Elias 2--27 revealed a two-armed spiral structure. The observed morphology, together with the young age of the star and the disk-to-star mass ratio estimated from dust-continuum emission, make this system a perfect laboratory to investigate the role of self-gravity in the early phases of star formation. This is particularly interesting if we consider that gravitational instabilities could be a fundamental first step for the formation of planetesimals and planets. In this Letter, we model the rotation curve obtained by CO data of Elias 2--27 with a theoretical rotation curve, including both the disk self-gravity and the star contribution to the gravitational potential. We compare this model with a purely Keplerian one and with a simple power-law function. We find that (especially for the 13CO isotopologue) the rotation curve is better described by considering not only the star, but also the disk self-gravity. We are thus able to obtain for the first time a dynamical estimate of the disk mass of 0.08 \textpm{} 0.04 M {$\odot$} and the star mass of 0.46 \textpm{} 0.03 M {$\odot$} (in the more general case), the latter being comparable with previous estimates. From these values, we derive that the disk is 17\% of the star mass, meaning that it could be prone to gravitational instabilities. This result would strongly support the hypothesis that the two spiral arms are generated by gravitational instabilities.},
  langid = {english},
  file = {/Users/kmaitreys/Zotero/storage/I4CUDT3I/Veronesi et al. - 2021 - A Dynamical Measurement of the Disk Mass in Elias 2–27.pdf}
}

@article{vialaChemicalEquilibriumDiffuse1988,
  title = {Chemical Equilibrium from Diffuse to Dense Interstellar Clouds. {{III}}. {{The}} Model of the Diffuse Cloud Dzeta {{Ophiuchi}} Revisited.},
  author = {Viala, Y. P. and Roueff, E. and Abgrall, H.},
  year = 1988,
  month = jan,
  journal = {Astronomy and Astrophysics},
  volume = {190},
  pages = {215--236},
  issn = {0004-6361},
  urldate = {2023-09-03},
  abstract = {A steady state model of the chemical composition of interstellar clouds is used to ascertain the physical conditions prevailing in the diffuse cloud in front of the star Zeta Ophiuchii and in its environment. The chemical reaction scheme involves 1092 reactions among 85 chemical species; the chemistry of the deuterated species D, D(+), HD, HD(+), and H2D(+) is added to the chemical network. Photoabsorption and photodissociation rates for each individual line of the Lyman and Werner band of H2 and HD are computed as a function of depth in the cloud by solving a transfer equation for each line which takes all possible absorbers into account. This results in very efficient UV radiation shielding and leads to a transition from H to H2 which is more rapid than in previous models.},
  keywords = {Astronomical Models,Astrophysics,Carbon Compounds,Chemical Equilibrium,Hydroxyl Radicals,Interstellar Chemistry,Molecular Clouds,Molecular Excitation,Ophiuchi Clouds,Oscillator Strengths,Ultraviolet Radiation},
  file = {/Users/kmaitreys/Zotero/storage/Q75FF8CA/Viala et al. - 1988 - Chemical equilibrium from diffuse to dense interst.pdf;/Users/kmaitreys/Zotero/storage/WFHPUV3T/Viala et al. - 1988 - Chemical equilibrium from diffuse to dense interst.pdf}
}

@article{vioqueALMASurveyGas2025,
  title = {The {{ALMA Survey}} of {{Gas Evolution}} of {{PROtoplanetary Disks}} ({{AGE-PRO}}). {{X}}. {{Dust Substructures}}, {{Disk Geometries}}, and {{Dust-disk Radii}}},
  author = {Vioque, Miguel and Kurtovic, Nicol{\'a}s T. and Trapman, Leon and Sierra, Anibal and P{\'e}rez, Laura M. and Zhang, Ke and Curone, Pietro and Rosotti, Giovanni P. and Carpenter, John and Tabone, Beno{\^i}t and Pinilla, Paola and Deng, Dingshan and Pascucci, Ilaria and Miley, James and {Agurto-Gangas}, Carolina and Cieza, Lucas A. and Anania, Rossella and {Ruiz-Rodriguez}, Dary A. and {Gonz{\'a}lez-Ruilova}, Camilo and TorresVillanueva, Estephani E. and Kuznetsova, Aleksandra},
  year = 2025,
  month = aug,
  journal = {The Astrophysical Journal},
  volume = {989},
  number = {1},
  pages = {9},
  issn = {0004-637X, 1538-4357},
  doi = {10.3847/1538-4357/adc7b0},
  urldate = {2026-08-30},
  abstract = {Abstract                            We perform visibility fitting to the dust continuum Band 6 1.3 mm data of the 30 protoplanetary disks in the Atacama Large Millimeter/submillimeter Array Survey of Gas Evolution of PROtoplanetary Disks (AGE-PRO) Large Program. We obtain disk geometries, dust-disk radii, and azimuthally symmetric radial profiles of the intensity of the dust continuum emission. We examine the presence of continuum substructures in the AGE-PRO sample by using these radial profiles and their residuals. We detect substructures in 15 out of 30 disks. We report five disks with large ({$>$}15 au) inner dust cavities. The Ophiuchus Class I disks show dust-disk substructures in {$\sim$}80\% of the resolved sources. This evidences the early formation of substructures in protoplanetary disks. A spiral is identified in IRS 63, hinting to gravitational instability in this massive disk. We compare our dust-disk brightness radial profiles with gas-disk brightness radial profiles and discuss colocal substructures in both tracers. In addition, we discuss the evolution of dust-disk radii and substructures across Ophiuchus, Lupus, and Upper Scorpius. We find that disks in Lupus and Upper Scorpius with large inner dust cavities have typical gas-disk masses, suggesting an abundance of dust cavities in these regions. The prevalence of pressure dust traps at later ages is supported by a potential trend with time with more disks with large inner dust cavities (or               transition disks               ) in Upper Scorpius and the absence of evolution of dust-disk sizes with time in the AGE-PRO sample. We propose this is caused by an evolutionary sequence with a high fraction of protoplanetary disks with inner protoplanets carving dust cavities.},
  langid = {english},
  file = {/Users/kmaitreys/Zotero/storage/AN35MH33/Vioque et al. - 2025 - The ALMA Survey of Gas Evolution of PROtoplanetary Disks (AGE-PRO). X. Dust Substructures, Disk Geom.pdf}
}

