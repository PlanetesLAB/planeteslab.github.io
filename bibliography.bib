@article{baoDirectImagingDebris2026,
  title = {Direct {{Imaging}} for the {{Debris Disk}} around {$\epsilon$} {{Eridani}} with the {{Cool-planet Imaging Coronagraph}}},
  author = {Bao, Chun-Hui and Ji, Jiang-Hui and Zhao, Gang and Zhu, Yi-Ming and Dou, Jiang-Pei and Wang, Su and Dong, Yao},
  year = 2026,
