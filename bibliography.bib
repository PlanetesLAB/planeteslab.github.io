  doi = {10.1093/mnras/stab1675},
  urldate = {2025-11-22},
  abstract = {Circumstellar discs may become warped or broken into distinct planes if there is a stellar or planetary companion with an orbit that is misaligned with respect to the disc. There is mounting observational evidence for protoplanetary discs with misaligned inner discs and warps that may be caused by such interactions with a previously undetected companion, giving us a tantalizing indication of possible planets forming there. Hydrodynamical and radiative transfer models indicate that the temperature varies azimuthally in warped discs due to the variable angle at which the disc surface faces the star and this impacts the disc chemistry. We perform chemical modelling based on a hydrodynamical model of a protoplanetary disc with an embedded planet orbiting at a 12{$^\circ$} inclination to the disc. Even for this small misalignment, abundances of species including CO and HCO+ vary azimuthally and this results in detectable azimuthal variations in submillimetre line emission. Azimuthal variations in line emission may therefore indicate the presence of an unseen embedded companion. Non-axisymmetric chemical abundances should be considered when interpreting molecular line maps of warped or shadowed protoplanetary discs.},
  file = {/Users/kmaitreys/Zotero/storage/E9GCI799/Young et al. - 2021 - Chemical signatures of a warped protoplanetary disc.pdf}
}

@article{yuksekSwitchingNegativePositive2009,
  title = {Switching from Negative to Positive Nonlinear Absorption in p Type 0.5at\% {{Sn}} Doped {{GaSe}} Semiconductor Crystal},
  author = {Y{\"u}ksek, M. and Elmali, A. and Karabulut, M. and Mamedov, G. M.},
