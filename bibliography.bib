  doi = {10.1111/j.1365-2966.2006.10488.x},
  urldate = {2026-02-17},
  abstract = {We perform numerical simulations of a disc--planet system using various grid-based and smoothed particle hydrodynamics (SPH) codes. The tests are run for a simple setup where Jupiter and Neptune mass planets on a circular orbit open a gap in a protoplanetary disc during a few hundred orbital periods. We compare the surface density contours, potential vorticity and smoothed radial profiles at several times. The disc mass and gravitational torque time evolution are analysed with high temporal resolution. There is overall consistency between the codes. The density profiles agree within about 5 per cent for the Eulerian simulations. The SPH results predict the correct shape of the gap although have less resolution in the low-density regions and weaker planetary wakes. The disc masses after 200 orbital periods agree within 10 per cent. The spread is larger in the tidal torques acting on the planet which agree within a factor of 2 at the end of the simulation. In the Neptune case, the dispersion in the torques is greater than for Jupiter, possibly owing to the contribution from the not completely cleared region close to the planet.},
  file = {/Users/kmaitreys/Zotero/storage/ETTYRN9F/De Val-Borro et al. - 2006 - A comparative study of disc–planet interaction.pdf;/Users/kmaitreys/Zotero/storage/A6H85UKX/j.1365-2966.2006.10488.html}
}

@article{dionatosConsistentDustGas2019,
  title = {Consistent Dust and Gas Models for Protoplanetary Disks: {{IV}}. {{A}} Panchromatic View of Protoplanetary Disks},
  shorttitle = {Consistent Dust and Gas Models for Protoplanetary Disks},
  author = {Dionatos, O. and Woitke, P. and G{\"u}del, M. and Degroote, P. and Liebhart, A. and Anthonioz, F. and Antonellini, S. and {Baldovin-Saavedra}, C. and Carmona, A. and Dominik, C. and Greaves, J. and Ilee, J. D. and Kamp, I. and M{\'e}nard, F. and Min, M. and Pinte, C. and Rab, C. and Rigon, L. and Thi, W. F. and Waters, L. B. F. M.},
  year = 2019,
  month = may,
  journal = {Astronomy \& Astrophysics},
  volume = {625},
  pages = {A66},
  issn = {0004-6361, 1432-0746},
  doi = {10.1051/0004-6361/201832860},
  urldate = {2024-04-20},
  abstract = {Context. Consistent modeling of protoplanetary disks requires the simultaneous solution of both continuum and line radiative transfer, heating and cooling balance between dust and gas and, of course, chemistry. Such models depend on panchromatic observations that can provide a complete description of the physical and chemical properties and energy balance of protoplanetary systems. Along these lines, we present a homogeneous, panchromatic collection of data on a sample of 85 T Tauri and Herbig Ae objects for which data cover a range from X-rays to centimeter wavelengths. Datasets consist of photometric measurements, spectra, along with results from the data analysis such as line fluxes from atomic and molecular transitions. Additional properties resulting from modeling of the sources such as disk mass and shape parameters, dust size, and polycyclic aromatic hydrocarbon (PAH) properties are also provided for completeness.},
  copyright = {https://www.edpsciences.org/en/authors/copyright-and-licensing},
  langid = {english},
  file = {/Users/kmaitreys/Zotero/storage/QT3CLJQJ/Dionatos et al. - 2019 - Consistent dust and gas models for protoplanetary .pdf}
}

@article{dixitSearchingDarkMatter2021,
  title = {Searching for {{Dark Matter}} with a {{Superconducting Qubit}}},
  author = {Dixit, Akash V. and Chakram, Srivatsan and He, Kevin and Agrawal, Ankur and Naik, Ravi K. and Schuster, David I. and Chou, Aaron},
  year = 2021,
  month = apr,
  journal = {Physical Review Letters},
  volume = {126},
  number = {14},
  eprint = {2008.12231},
  primaryclass = {hep-ex, physics:quant-ph},
  pages = {141302},
  issn = {0031-9007, 1079-7114},
  doi = {10.1103/PhysRevLett.126.141302},
  urldate = {2023-11-27},
  abstract = {Detection mechanisms for low mass bosonic dark matter candidates, such the axion or hidden photon, leverage potential interactions with electromagnetic fields, whereby the dark matter (of unknown mass) on rare occasion converts into a single photon. Current dark matter searches operating at microwave frequencies use a resonant cavity to coherently accumulate the field sourced by the dark matter and a near standard quantum limited (SQL) linear amplifier to read out the cavity signal. To further increase sensitivity to the dark matter signal, sub-SQL detection techniques are required. Here we report the development of a novel microwave photon counting technique and a new exclusion limit on hidden photon dark matter. We operate a superconducting qubit to make repeated quantum non-demolition measurements of cavity photons and apply a hidden Markov model analysis to reduce the noise to 15.7 dB below the quantum limit, with overall detector performance limited by a residual background of real photons. With the present device, we perform a hidden photon search and constrain the kinetic mixing angle to \$\textbackslash epsilon \textbackslash leq 1.68 \textbackslash times 10\textasciicircum\textbraceleft -15\textbraceright\$ in a band around 6.011 GHz (24.86 \$\textbackslash mu\$eV) with an integration time of 8.33 s. This demonstrated noise reduction technique enables future dark matter searches to be sped up by a factor of 1300. By coupling a qubit to an arbitrary quantum sensor, more general sub-SQL metrology is possible with the techniques presented in this work.},
  archiveprefix = {arXiv},
  keywords = {High Energy Physics - Experiment,Quantum Physics},
  file = {/Users/kmaitreys/Zotero/storage/IR38D6FM/Dixit et al. - 2021 - Searching for Dark Matter with a Superconducting Q.pdf;/Users/kmaitreys/Zotero/storage/TBQVWJFJ/2008.html}
}

