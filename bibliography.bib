@article{furlanettoCosmologyLowFrequencies2006,
  title = {Cosmology at {{Low Frequencies}}: {{The}} 21 Cm {{Transition}} and the {{High-Redshift Universe}}},
  shorttitle = {Cosmology at {{Low Frequencies}}},
  author = {Furlanetto, Steven and Oh, S. Peng and Briggs, Frank},
  year = 2006,
  month = oct,
  journal = {Physics Reports},
  volume = {433},
  number = {4-6},
  eprint = {astro-ph/0608032},
  pages = {181--301},
  issn = {03701573},
  doi = {10.1016/j.physrep.2006.08.002},
  urldate = {2022-11-22},
  abstract = {Observations of the high-redshift Universe with the 21 cm hyperfine line of neutral hydrogen promise to open an entirely new window onto the early phases of cosmic structure formation. Here we review the physics of the 21 cm transition, focusing on processes relevant at high redshifts, and describe the insights to be gained from such observations. These include measuring the matter power spectrum at z\textasciitilde 50, observing the formation of the cosmic web and the first luminous sources, and mapping the reionization of the intergalactic medium. The epoch of reionization is of particular interest, because large HII regions will seed substantial fluctuations in the 21 cm background. We also discuss the experimental challenges involved in detecting this signal, with an emphasis on the Galactic and extragalactic foregrounds. These increase rapidly toward low frequencies and are especially severe for the highest redshift applications. Assuming that these difficulties can be overcome, the redshifted 21 cm line will offer unique insight into the high-redshift Universe, complementing other probes but providing the only direct, three-dimensional view of structure formation from z\textasciitilde 200 to z\textasciitilde 6.},
  archiveprefix = {arXiv},
  keywords = {Astrophysics}
}

