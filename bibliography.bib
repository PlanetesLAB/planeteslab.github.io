@article{brownChemicalModelsInterstellar1990,
  title = {Chemical Models of Interstellar Gas-Grain Processes. {{I}}. {{Modelling}} and the Effect of Accretion on Gas Abundances and Mantle Composition in Dense Clouds.},
  author = {Brown, Paul D. and Charnley, S. B.},
  year = 1990,
  month = jun,
  journal = {Monthly Notices of the Royal Astronomical Society},
  volume = {244},
  pages = {432},
  publisher = {OUP},
  issn = {0035-8711},
  urldate = {2024-09-13},
  abstract = {A model has been developed to study the time-dependent gas-grain chemical interaction in dense, quiescent interstellar clouds. Results are presented from the simplest form of this interaction: simple accretion of gas phase molecules on to dust grains in a static cloud. It is shown that gas phase evolution under accretion is nontrivial with respect to standard time-dependent models in which accretion is ignored. Substantial ice mantles consisting mostly of water and solid CO can coexist with a well-developed gas phase chemistry. The inclusion of accretion and time-dependent abundances prior to freeze-out produces good agreement with observations on time-scales relevant to the age of the dark cloud TMC-1, compared to that obtained from considering chemical equilibrium abundances.},
  keywords = {Abundance,Astronomical Models,Astrophysics,Chemical Equilibrium,Cosmic Dust,Ice,Interstellar Chemistry,Interstellar Gas,Magellanic Clouds,Molecular Clouds,Time Dependence},
  file = {/Users/kmaitreys/Zotero/storage/L27ZW5CC/Brown and Charnley - 1990 - Chemical models of interstellar gas-grain processes. I. Modelling and the effect of accretion on gas.pdf}
}

@article{brownChemicalModelsInterstellar1991,
  title = {Chemical Models of Interstellar Gas--Grain Processes -- {{II}}. {{The}} Effect of Grain-Catalysed Methane on Gas Phase Evolution},
  author = {Brown, Paul D. and Charnley, S. B.},
  year = 1991,
  month = mar,
  journal = {Monthly Notices of the Royal Astronomical Society},
  volume = {249},
  number = {1},
