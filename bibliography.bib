  issn = {0004-6361, 1432-0746},
  doi = {10.1051/0004-6361/200811555},
  urldate = {2024-04-20},
  abstract = {Aims. Solving the continuum radiative transfer equation in high opacity media requires sophisticated numerical tools. In order to test the reliability of such tools, we present a benchmark of radiative transfer codes in a 2D disc configuration. Methods. We test the accuracy of seven independently developed radiative transfer codes by comparing the temperature structures, spectral energy distributions, scattered light images, and linear polarisation maps that each model predicts for a variety of disc opacities and viewing angles. The test cases have been chosen to be numerically challenging, with midplane optical depths up 106, a sharp density transition at the inner edge and complex scattering matrices. We also review recent progress in the implementation of the Monte Carlo method that allow an efficient solution to these kinds of problems and discuss the advantages and limitations of Monte Carlo codes compared to those of discrete ordinate codes.},
  langid = {english},
  file = {/Users/kmaitreys/Zotero/storage/UALKV3G8/Pinte et al. - 2009 - Benchmark problems for continuum radiative transfe.pdf}
}

@article{pinteExoALMAChannelMaps2025,
  title = {{{exoALMA}}. {{X}}. {{Channel Maps Reveal Complex 12CO Abundance Distributions}} and a {{Variety}} of {{Kinematic Structures}} with {{Evidence}} for {{Embedded Planets}}},
  author = {Pinte, Christophe and Ilee, John D. and Huang, Jane and Benisty, Myriam and Facchini, Stefano and Fukagawa, Misato and Teague, Richard and Bae, Jaehan and {Barraza-Alfaro}, Marcelo and Cataldi, Gianni and Cuello, Nicol{\'a}s and Curone, Pietro and Czekala, Ian and Fasano, Daniele and Flock, Mario and {Galloway-Sprietsma}, Maria and Garg, Himanshi and Hall, Cassandra and Hammond, Iain and Hardiman, Caitlyn and Hilder, Thomas and Izquierdo, Andr{\'e}s F. and Kanagawa, Kazuhiro and Lesur, Geoffroy and Lodato, Giuseppe and Longarini, Cristiano and Loomis, Ryan A. and Masset, Fr{\'e}d{\'e}ric and Menard, Francois and Orihara, Ryuta and Price, Daniel J. and Rosotti, Giovanni and Stadler, Jochen and Yen, Hsi-Wei and {Wafflard-Fernandez}, Gaylor and Wilner, David J. and Winter, Andrew J. and W{\"o}lfer, Lisa and Yoshida, Tomohiro C. and Zawadzki, Brianna},
  year = 2025,
