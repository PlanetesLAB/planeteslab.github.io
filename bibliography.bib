@article{bertschingerSelfsimilarSecondaryInfall1985,
  title = {Self-Similar Secondary Infall and Accretion in an {{Einstein-de Sitter}} Universe},
  author = {Bertschinger, E.},
  year = 1985,
  month = may,
  journal = {The Astrophysical Journal Supplement Series},
  volume = {58},
  pages = {39--65},
  issn = {0067-0049},
  doi = {10.1086/191028},
  urldate = {2022-11-28},
  abstract = {Similarity solutions are given for secondary infall onto an accreting center in an Einstein-de Sitter universe. The case of a central black hole quietly accreting all the infalling gas is considered first. If there is no central black hole and the gas is collisional, a shock forms and propagates outward; similarity solutions are given for the adiabatic postshock flow. Solutions for collisionless fluid shells and for a collisional fluid with omega much less than one moving in the potential of the omega = 1 collisionless solution are presented. A comparison is made with similarity solutions found recently for expanding voids by Bertschinger (1985), and it is shown how the collisionless similarity solutions can be used to infer the ages of objects formed by secondary infall.},
  keywords = {Accretion Disks,Astrophysics,Black Holes (Astronomy),Collisional Plasmas,Collisionless Plasmas,Cosmology,Density Distribution,Galactic Clusters,Galactic Evolution,Galactic Structure,Gravitational Collapse,Hydrodynamics,Perturbation Theory,Relativity,Shock Wave Propagation,Similarity Theorem}
}

