  author = {Irvine, W. M. and Friberg, P. and Kaifu, N. and Kawaguchi, K. and Kitamura, Y. and Matthews, H. E. and Minh, Y. and Saito, S. and Ukita, N. and Yamamoto, S.},
  year = 1989,
