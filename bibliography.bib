  urldate = {2022-06-22},
  abstract = {The influence of the basic rotation on anisotropic and inhomogeneous turbulence is discussed in the context of differential rotation theory. An improved representation for the original turbulence leads to a \$\textbackslash Lam\$-effect which complies with the results of 3D numerical simulations. The resulting rotation law and meridional flow agree well with both the surface observations (\$\textbackslash partial\textbackslash Om/\textbackslash partial r{$<$}0\$ and meridional flow towards the poles) and with the findings of helioseismology. The computed equatorward flow at the bottom of convection zone has an amplitude of about 10 m/s and may be significant for the solar dynamo. The depth of the meridional flow penetration into the radiative zone is proportional to \$\textbackslash nu\textasciicircum\textbraceleft 0.5\textbraceright\_\textbackslash mathrm\textbraceleft core\textbraceright\$, where \$\textbackslash nu\_\textbackslash mathrm\textbraceleft core\textbraceright\$ is the viscosity beneath the convection zone. The penetration is very small if the tachocline is laminar.},
  archiveprefix = {arXiv},
  keywords = {Astrophysics},
  file = {/Users/kmaitreys/Zotero/storage/QYNSWNYU/Kitchatinov and Rüdiger - 2005 - Differential rotation and meridional flow in the s.pdf;/Users/kmaitreys/Zotero/storage/LH9VMKWU/0506239.html}
}

