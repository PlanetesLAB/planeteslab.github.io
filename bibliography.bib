@article{alpaslanGalaxyMassAssembly2014,
  title = {Galaxy and {{Mass Assembly}} ({{GAMA}}): Fine Filaments of Galaxies Detected within Voids},
  shorttitle = {Galaxy and {{Mass Assembly}} ({{GAMA}})},
  author = {Alpaslan, Mehmet and Robotham, Aaron S. G. and Obreschkow, Danail and Penny, Samantha and Driver, Simon and Norberg, Peder and Brough, Sarah and Brown, Michael and Cluver, Michelle and Holwerda, Benne and Hopkins, Andrew M. and {van Kampen}, Eelco and Kelvin, Lee S. and {Lara-Lopez}, Maritza A. and Liske, Jochen and Loveday, Jon and Mahajan, Smriti and Pimbblet, Kevin},
  year = 2014,
  month = may,
  journal = {Monthly Notices of the Royal Astronomical Society: Letters},
  volume = {440},
  number = {1},
  pages = {L106-L110},
  issn = {1745-3933, 1745-3925},
  doi = {10.1093/mnrasl/slu019},
  urldate = {2022-08-27},
  abstract = {Based on data from the Galaxy and Mass Assembly (GAMA) survey, we report on the discovery of structures that we refer to as `tendrils' of galaxies: coherent, thin chains of galaxies that are rooted in filaments and terminate in neighbouring filaments or voids. On average, tendrils contain six galaxies and span 10 h-1 Mpc. We use the so-called line correlation function to prove that tendrils represent real structures rather than accidental alignments. We show that voids found in the Sloan Digital Sky Survey, 7th data release survey that overlap with GAMA regions contain a large number of galaxies, primarily belonging to tendrils. This implies that void sizes are strongly dependent on the number density and sensitivity limits of a survey. We caution that galaxies in low-density regions, which may be defined as `void galaxies,' will have local galaxy number densities that depend on such observational limits and are likely higher than those can be directly measured.},
  langid = {english}
}

