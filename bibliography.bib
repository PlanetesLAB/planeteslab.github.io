@article{tanimuraDetectionInterclusterGas2019,
  title = {Detection of Intercluster Gas in Superclusters Using the Thermal {{Sunyaev-Zel}}'dovich Effect},
  author = {Tanimura, H. and Aghanim, N. and Douspis, M. and Beelen, A. and Bonjean, V.},
  year = 2019,
  month = may,
  journal = {Astronomy \& Astrophysics},
  volume = {625},
  eprint = {1805.04555},
  primaryclass = {astro-ph},
  pages = {A67},
  issn = {0004-6361, 1432-0746},
  doi = {10.1051/0004-6361/201833413},
  urldate = {2022-06-03},
  abstract = {Using a thermal Sunyaev-Zel'dovich (tSZ) signal, we search for hot gas in superclusters identified using the Sloan Digital Sky Survey Data Release 7 (SDSS/DR7) galaxies. We stack a Comptonization y map produced by the Planck Collaboration around the superclusters and detect the tSZ signal at a significance of 6.4 sigma. We further search for an intercluster component of gas in the superclusters. For this, we remove the intracluster gas in the superclusters by masking all galaxy groups/clusters detected by the Planck tSZ, ROSAT X-ray, and SDSS optical surveys down to a total mass of 10\textasciicircum 13 Msun. We report the first detection of intercluster gas in superclusters with y = (3.5 +- 1.4) * 10\textasciicircum (-8) at a significance of 2.5 sigma. Assuming a simple isothermal and flat density distribution of intercluster gas over superclusters, the estimated baryon density is (Omega\_gas / Omega\_b) * (T\_e/(8*10\textasciicircum 6 K)) = 0.067 +- 0.006 +- 0.025. This quantity is inversely proportional to the temperature, therefore taking values from simulations and observations, we find that the gas density in superclusters may account for 17 - 52 \% of missing baryons at low redshifts. A better understanding of the physical state of gas in the superclusters is required to accurately estimate the contribution of our measurements to missing baryons.},
  archiveprefix = {arXiv},
  keywords = {Astrophysics - Cosmology and Nongalactic Astrophysics},
  file = {/Users/kmaitreys/Zotero/storage/SKDCYGSZ/Tanimura et al. - 2019 - Detection of intercluster gas in superclusters usi.pdf;/Users/kmaitreys/Zotero/storage/AZLNLEU2/1805.html}
}

