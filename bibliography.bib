@article{trapmanExoALMAXIIIGas2025,
  title = {{{exoALMA}}. {{XIII}}. {{Gas Masses}} from {{N2H}}+ and {{C18O}}: {{A Comparison}} of {{Measurement Techniques}} for {{Protoplanetary Gas Disk Masses}}},
  shorttitle = {{{exoALMA}}. {{XIII}}. {{Gas Masses}} from {{N2H}}+ and {{C18O}}},
  author = {Trapman, Leon and Longarini, Cristiano and Rosotti, Giovanni P. and Andrews, Sean M. and Bae, Jaehan and {Barraza-Alfaro}, Marcelo and Benisty, Myriam and Cataldi, Gianni and Curone, Pietro and Czekala, Ian and Facchini, Stefano and Fasano, Daniele and Flock, Mario and Fukagawa, Misato and {Galloway-Sprietsma}, Maria and Garg, Himanshi and Hall, Cassandra and Huang, Jane and Ilee, John D. and Izquierdo, Andres F. and Kanagawa, Kazuhiro and Lesur, Geoffroy and Lodato, Giuseppe and Loomis, Ryan A. and Orihara, Ryuta and {Paneque-Carreno}, Teresa and Pinte, Christophe and Price, Daniel and Stadler, Jochen and Teague, Richard and {van Terwisga}, Sierk and Testi, Leonardo and Yen, Hsi-Wei and {Wafflard-Fernandez}, Gaylor and Wilner, David J. and Winter, Andrew J. and W{\"o}lfer, Lisa and Yoshida, Tomohiro C. and Zawadzki, Brianna and Zhang, Ke},
  year = 2025,
  month = apr,
  journal = {The Astrophysical Journal Letters},
  volume = {984},
  number = {1},
  pages = {L18},
  publisher = {The American Astronomical Society},
  issn = {2041-8205},
  doi = {10.3847/2041-8213/adc430},
  urldate = {2026-09-28},
  abstract = {The gas masses of protoplanetary disks are important but elusive quantities. In this work we present new Atacama Large Millimeter/submillimeter Array (ALMA) observations of N2H+ (3--2) for 11 exoALMA disks. N2H+ is a molecule sensitive to CO freeze-out and has recently been shown to significantly improve the accuracy of gas masses estimated from CO line emission. We combine these new observations with archival N2H+ and CO isotopologue observations to measure gas masses for 19 disks, predominantly from the exoALMA large program. For 15 of these disks the gas mass has also been measured using gas rotation curves. We show that the CO + N2H+ line emission-based gas masses typically agree with the kinematically measured ones within a factor of 3 ({$\sim$}1{$\sigma$}--2{$\sigma$}). Gas disk masses from CO + N2H+ are on average a factor of lower than the kinematic disk masses, which could suggest slightly lower N2 abundances and/or lower midplane ionization rates than typically assumed. Herbig disks are found to have CO gas abundances at the level of the interstellar medium based on their CO and N2H+ fluxes, which sets them apart from T Tauri disks, where abundances are typically {$\sim$}3-30\texttimes{} lower. The agreement between CO + N2H+-based and kinematically measured gas masses is promising and shows that multimolecule line fluxes are a robust tool to accurately measure disk masses at least for extended disks.},
  langid = {english},
  file = {/Users/kmaitreys/Zotero/storage/4GR834E2/Trapman et al. - 2025 - exoALMA. XIII. Gas Masses from N2H+ and C18O A Comparison of Measurement Techniques for Protoplanet.pdf}
}

@article{trapmanFarinfraredHDEmission2017,
  title = {Far-Infrared {{HD}} Emission as a Measure of Protoplanetary Disk Mass},
  author = {Trapman, L. and Miotello, A. and Kama, M. and van Dishoeck, E. F. and Bruderer, S.},
  year = 2017,
  month = sep,
  journal = {Astronomy \& Astrophysics},
  volume = {605},
  pages = {A69},
  publisher = {EDP Sciences},
  issn = {0004-6361, 1432-0746},
  doi = {10.1051/0004-6361/201630308},
  urldate = {2025-03-08},
  abstract = {\emph{Context. {$<$}i/{$>$}Protoplanetary disks around young stars are the sites of planet formation. While the dust mass can be estimated using standard methods, determining the gas mass -- and thus the amount of material available to form giant planets -- has proven to be very difficult. Hydrogen deuteride (HD) is a promising alternative to the commonly used gas mass tracer, carbon monoxide. However, the potential of HD has not yet been investigated with models incorporating both HD and CO isotopologue-specific chemistry, and its sensitivity to uncertainties in disk parameters has not yet been quantified.\emph{Aims. {$<$}i/{$>$}We examine the robustness of HD as tracer of the disk gas mass, specifically the effect of gas mass on HD far-infrared emission and its sensitivity to the vertical structure. Also, we seek to provide requirements for future far-infrared missions such as SPICA.\emph{Methods. {$<$}i/{$>$}Deuterium chemistry reactions relevant for HD were implemented in the thermochemical code DALI and more than 160 disk models were run for a range of disk masses and vertical structures.\emph{Results. {$<$}i/{$>$}The HD \emph{J{$<$}i/{$>$} = 1--0 line intensity depends directly on the gas mass through a sublinear power law relation with a slope of \textasciitilde 0.8. Assuming no prior knowledge about the vertical structure of a disk and using only the HD 1--0 flux, gas masses can be estimated to within a factor of two for low mass disks (\emph{M{$<$}i/{$>$}\textsubscript{disk{$<$}sub/{$>$} {$\leq$} 10\textsuperscript{-3{$<$}sup/{$>$}\emph{M{$<$}i/{$>$}\textsubscript{{$\odot<$}sub/{$>$}). For more massive disks, this uncertainty increases to more than an order of magnitude. Adding the HD 2--1 line or independent information about the vertical structure can reduce this uncertainty to a factor of \textasciitilde{} 3 for all disk masses. For TW Hya, using the radial and vertical structure from the literature, the observations constrain the gas mass to 6 \texttimes{} 10\textsuperscript{-3{$<$}sup/{$>$}\emph{M{$<$}i/{$>$}\textsubscript{{$\odot<$}sub/{$>$} {$\leq$} \emph{M{$<$}i/{$>$}\textsubscript{disk{$<$}sub/{$>$} {$\leq$} 9 \texttimes{} 10\textsuperscript{-3{$<$}sup/{$>$}\emph{M{$<$}i/{$>$}\textsubscript{{$\odot<$}sub/{$>$}. Future observations require a 5\emph{{$\sigma<$}i/{$>$} sensitivity of 1.8 \texttimes{} 10\textsuperscript{-20{$<$}sup/{$>$} W m\textsuperscript{-2{$<$}sup/{$>$} (2.5 \texttimes{} 10\textsuperscript{-20{$<$}sup/{$>$} W m\textsuperscript{-2{$<$}sup/{$>$}) and a spectral resolving power \emph{R{$<$}i/{$>$} {$\geq$} 300 (1000) to detect HD 1--0 (HD 2--1) for all disk masses above 10\textsuperscript{-5{$<$}sup/{$>$}\emph{M{$<$}i/{$>$}\textsubscript{{$\odot<$}sub/{$>$} with a line-to-continuum ratio {$\geq$} 0.01.\emph{Conclusions. {$<$}i/{$>$}These results show that HD can be used as an independent gas mass tracer with a relatively low uncertainty and should be considered an important science goal for future far-infrared missions.}}}}}}}}}}}}}}}}}}}}}}}}}}}}},
  copyright = {\copyright{} ESO, 2017},
  langid = {english},
  file = {/Users/kmaitreys/Zotero/storage/54XKJWVJ/Trapman et al. - 2017 - Far-infrared HD emission as a measure of protoplanetary disk mass.pdf}
}

@article{trapmanNovelWayMeasuring2022,
  title = {A {{Novel Way}} of {{Measuring}} the {{Gas Disk Mass}} of {{Protoplanetary Disks Using N2H}}+ and {{C18O}}},
  author = {Trapman, Leon and Zhang, Ke and van 't Hoff, Merel L. R. and Hogerheijde, Michiel R. and Bergin, Edwin A.},
  year = 2022,
  month = feb,
  journal = {The Astrophysical Journal Letters},
  volume = {926},
  number = {1},
  pages = {L2},
  publisher = {The American Astronomical Society},
  issn = {2041-8205},
  doi = {10.3847/2041-8213/ac4f47},
  urldate = {2023-05-12},
  abstract = {Measuring the gas mass of protoplanetary disks, the reservoir available for giant planet formation, has proven to be difficult. We currently lack a far-infrared observatory capable of observing HD, and the most common gas mass tracer, CO, suffers from a poorly constrained CO-to-H2 ratio. Expanding on previous work, we investigate if N2H+, a chemical tracer of CO-poor gas, can be used to observationally measure the CO-to-H2 ratio and correct CO-based gas masses. Using disk structures obtained from the literature, we set up thermochemical models for three disks, TW Hya, DM Tau and GM Aur, to examine how well the CO-to-H2 ratio and gas mass can be measured from N2H+ and C18O line fluxes. Furthermore, we compare these gas masses to gas masses independently measured from archival HD observations. The N2H+(3 - 2)/C18O(2 - 1) line ratio scales with the disk CO-to-H2 ratio. Using these two lines, we measure 4.6 \texttimes{} 10-3 M {$\odot$} {$\leq$} M disk {$\leq$} 1.1 \texttimes{} 10-1 M {$\odot$} for TW Hya, 1.5 \texttimes{} 10-2 M {$\odot$} {$\leq$} M disk {$\leq$} 9.6 \texttimes{} 10-2 M {$\odot$} for GM Aur and 3.1 \texttimes{} 10-2 M {$\odot$} {$\leq$} M disk {$\leq$} 9.6 \texttimes{} 10-2 M {$\odot$} for DM Tau. These gas masses agree with values obtained from HD within their respective uncertainties. The uncertainty on the N2H+ + C18O gas mass can be reduced by observationally constraining the cosmic-ray ionization rate in disks. These results demonstrate the potential of using the combination of N2H+ and C18O to measure gas masses of protoplanetary disks.},
  langid = {english},
  file = {/Users/kmaitreys/Zotero/storage/R2FSPF4C/Trapman_2022_ApJL_926_L2.pdf}
}

