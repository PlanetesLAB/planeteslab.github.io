@article{collinsCharacterisingLocalVoid2014,
  title = {Characterising the Local Void with the {{X-ray}} Cluster Survey {{REFLEX II}}},
  author = {Collins, Chris A. and B{\"o}hringer, Hans and Bristow, Martyn and Chon, Gayoung},
  year = 2014,
  month = jun,
  journal = {Proceedings of the International Astronomical Union},
  volume = {11},
  number = {S308},
  pages = {585--588},
  issn = {1743-9213, 1743-9221},
  doi = {10.1017/S1743921316010620},
  urldate = {2022-11-21},
  abstract = {Claims of a significant underdensity or void in the density distribution on scales out to 300 Mpc have recently been made using samples of galaxies. We present the results of an alternative test of the matter distribution on these scales using clusters of galaxies, which provide an independent and powerful probe of large-scale structure. We study the density distribution of X-ray clusters from the ROSAT-based REFLEX II catalogue, which covers a contiguous area of 4.24 steradians in the southern hempsphere (34\% of the entire sky). Using the normalised comoving number density of clusters we find evidence for an underdensity (30 - 40\%), out to z {$\sim$} 0.04, equivalent to 170 Mpc and with a significance of 3.4{$\sigma$}. On scales between 300 Mpc and 1 Gpc the distribution of REFLEX II clusters is consistent with being uniform. We also confirm recent results that the underdensity has a large contribution from the direction of the South Galactic Cap region, but is not significant in the direction of the Northern Galactic Cap as viewed from the southern sky. Both the limited size of the detected underdensity and its lack of isotropy, argue against the idea that the Type Ia supernovae data can be explained without the need for dark energy.},
  langid = {english}
}

