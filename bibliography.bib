@article{pustilnikObservationsDwarfsNearby2014,
  title = {Observations of Dwarfs in Nearby Voids: Implications for Galaxy Formation and Evolution},
  shorttitle = {Observations of Dwarfs in Nearby Voids},
  author = {Pustilnik, Simon A.},
  year = 2014,
  month = jun,
  journal = {Proceedings of the International Astronomical Union},
  volume = {11},
  number = {S308},
  pages = {606--609},
  issn = {1743-9213, 1743-9221},
  doi = {10.1017/S1743921316010668},
  urldate = {2022-11-21},
  abstract = {The intermediate results of the ongoing study of deep samples of {$\sim$}200 galaxies residing in nearby voids, are presented. Their properties are probed via optical spectroscopy, ugri surface photometry, and HI 21-cm line measurements, with emphasis on their evolutionary status. We derive directly the hydrogen mass M(HI), the ratio M (HI)/LB and the evolutionary parameter gas-phase O/H. Their luminosities and integrated colours are used to derive stellar mass M{$\ast$} and the second evolutionary parameter -- gas mass-fraction (fg ). The colours of the outer parts, typically representative of the galaxy oldest stellar population, are used to estimate the upper limits on time since the beginning of the main SF episode. We compare properties of void galaxies with those of the similar late-type galaxies in denser environments. Most of void galaxies show smaller O/H for their luminosity, in average by {$\sim$}30\%, indicating slower evolution. Besides, the fraction of {$\sim$}10\% of the whole void sample or {$\sim$}30\% of the least luminous void LSB dwarfs show the oxygen deficiency by a factor of 2--5. The majority of this group appear very gas-rich, with fg {$\sim$}(95--99)\%, while their outer parts appear rather blue, indicating the time of onset of the main star-formation episode of less than 1--4 Gyr. Such unevolved LSBD galaxies appear not rare among the smallest void objects, but turned out practically missed to date due to the strong observational selection effects. Our results evidense for unusual evolutionary properties of the sizable fraction of void galaxies, and thus, pose the task of better modelling of dwarf galaxy formation and evolution in voids.},
  langid = {english}
}

