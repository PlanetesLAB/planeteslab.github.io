  doi = {10.1093/mnras/staa2700},
  urldate = {2023-10-13},
  abstract = {Carbon containing molecules in cold molecular clouds show various levels of isotopic fractionation through multiple observations. To understand such effects, we have developed a new gas-grain chemical model with updated 13C fractionation reactions (also including the corresponding reactions for 15~N, 18O, and 34S). For chemical ages typical of dense clouds, our nominal model leads to two 13C reservoirs: CO and the species that derive from CO, mainly s-CO and s-CH3OH, as well as C3 in the gas phase. The nominal model leads to strong enrichment in C3, c-C3H2, and C2H in contradiction with observations. When C3 reacts with oxygen atoms, the global agreement between the various observations and the simulations is rather good showing variable 13C fractionation levels that are specific to each species. Alternatively, hydrogen atom reactions lead to notable relative 13C fractionation effects for the two non-equivalent isotopologues of C2H, c-C3H2, and C2S. As there are several important fractionation reactions, some carbon bearing species are enriched in 13C, particularly CO, depleting atomic 13C in the gas phase. This induces a 13C depletion in CH4 formed on grain surfaces, an effect that is not observed in the CH4 in the Solar system, in particular on Titan. This seems to indicate a transformation of matter between the collapse of the molecular clouds, leading to the formation of the protostellar disc, and the formation of the planets. Or it means that the atomic carbon sticking to the grains reacts with the species already on the grains giving very little CH4.},
  file = {/Users/kmaitreys/Zotero/storage/5ESJIZF9/Loison et al. - 2020 - Gas-grain model of carbon fractionation in dense m.pdf;/Users/kmaitreys/Zotero/storage/KLQG65FH/5903715.html}
}

@article{loisonGasphaseChemistryCarbon2014,
  title = {The Gas-Phase Chemistry of Carbon Chains in Dark Cloud Chemical Models},
  author = {Loison, Jean-Christophe and Wakelam, Valentine and Hickson, Kevin M. and Bergeat, Astrid and Mereau, Raphael},
  year = 2014,
  month = jan,
  journal = {Monthly Notices of the Royal Astronomical Society},
  volume = {437},
  number = {1},
  pages = {930--945},
  issn = {0035-8711},
  doi = {10.1093/mnras/stt1956},
  urldate = {2024-09-26},
  abstract = {We review the reactions between carbon chain molecules and radicals, namely Cn, CnH, CnH2, C2n+1O, CnN, HC2n+1N, with C, N and O atoms. Rate constants and branching ratios for these processes have been re-evaluated using experimental and theoretical literature data. In total 8 new species have been introduced, 41 new reactions have been proposed and 122 rate coefficients from kida.uva.2011 have been modified. We test the effect of the new rate constants and branching ratios on the predictions of gas--grain chemical models for dark cloud conditions using two different C/O elemental ratios. We show that the new rate constants produce large differences in the predicted abundances of carbon chains since the formation of long chains is less effective. The general agreement between the model predictions and observed abundances in the dark cloud TMC-1 (CP) is improved by the new network and we find that C/O ratios of 0.7 and 0.95 both produce a similar agreement for different times. The general agreement for L134N (N) is not significantly changed. The current work specifically highlights the importance of O\,+\,CnH and N\,+\,CnH reactions. As there are very few experimental or theoretical data for the rate constants of these reactions, we highlight the need for experimental studies of the O\,+\,CnH and N\,+\,CnH reactions, particularly at low temperature.},
  file = {/Users/kmaitreys/Zotero/storage/DYF85FBB/Loison et al. - 2014 - The gas-phase chemistry of carbon chains in dark cloud chemical models.pdf;/Users/kmaitreys/Zotero/storage/MG7PB5FH/1010018.html}
}

@article{loisonOxygenFractionationDense2019,
  title = {Oxygen Fractionation in Dense Molecular Clouds},
  author = {Loison, Jean-Christophe and Wakelam, Valentine and Gratier, Pierre and Hickson, Kevin M and Bacmann, Aurore and Ag{\`u}ndez, Marcelino and Marcelino, Nuria and Cernicharo, Jos{\'e} and Guzman, Viviana and Gerin, Maryvonne and Goicoechea, Javier R and Roueff, Evelyne and Petit, Franck Le and Pety, J{\'e}rome and Fuente, Asunci{\'o}n and {Riviere-Marichalar}, Pablo},
  year = 2019,
  month = jun,
  journal = {Monthly Notices of the Royal Astronomical Society},
  volume = {485},
  number = {4},
  pages = {5777--5789},
  issn = {0035-8711, 1365-2966},
  doi = {10.1093/mnras/stz560},
  urldate = {2023-10-13},
  abstract = {We have developed the first gas-grain chemical model for oxygen fractionation (also including sulphur fractionation) in dense molecular clouds, demonstrating that gas-phase chemistry generates variable oxygen fractionation levels, with a particularly strong effect for NO, SO, O2, and SO2. This large effect is due to the efficiency of the neutral 18O + NO, 18O + SO, and 18O + O2 exchange reactions. The modelling results were compared to new and existing observed isotopic ratios in a selection of cold cores. The good agreement between model and observations requires that the gas-phase abundance of neutral oxygen atoms is large in the observed regions. The S16O/S18O ratio is predicted to vary substantially over time, showing that it can be used as a sensitive chemical proxy for matter evolution in dense molecular clouds.},
  langid = {english},
  file = {/Users/kmaitreys/Zotero/storage/QB4N7G9J/Loison et al. - 2019 - Oxygen fractionation in dense molecular clouds.pdf}
}

