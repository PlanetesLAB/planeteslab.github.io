@incollection{vandeweygaertVoidGalaxySurvey2011,
  title = {The {{Void Galaxy Survey}}},
  author = {{van de Weygaert}, R. and Kreckel, K. and Platen, E. and Beygu, B. and {van Gorkom}, J. H. and {van der Hulst}, J. M. and {Aragon-Calvo}, M. A. and Peebles, P. J. E. and Jarrett, T. and Rhee, G. and Kovac, K. and Yip, C.-W.},
  year = 2011,
