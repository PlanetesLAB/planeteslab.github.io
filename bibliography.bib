}

@article{greenzweigAccretionRatesProtoplanets1992a,
  title = {Accretion Rates of Protoplanets  {{II}}. {{Gaussian}} Distributions of Planetesimal Velocities},
  author = {Greenzweig, Yuval and Lissauer, Jack J.},
