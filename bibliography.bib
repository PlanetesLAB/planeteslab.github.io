  shorttitle = {Benchmark Problems for Continuum Radiative Transfer},
  author = {Pinte, C. and Harries, T. J. and Min, M. and Watson, A. M. and Dullemond, C. P. and Woitke, P. and M{\'e}nard, F. and {Dur{\'a}n-Rojas}, M. C.},
