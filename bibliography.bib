@article{riedelModellingDeuteratedIsotopologues2023,
  title = {Modelling Deuterated Isotopologues of Methanol towards the Pre-Stellar Core {{L1544}}},
  author = {Riedel, W. and Sipil{\"a}, O. and Redaelli, E. and Caselli, P. and Vasyunin, A. I. and Dulieu, F. and Watanabe, N.},
  year = 2023,
  month = dec,
  journal = {Astronomy \& Astrophysics},
  volume = {680},
  pages = {A87},
  publisher = {EDP Sciences},
  issn = {0004-6361, 1432-0746},
  doi = {10.1051/0004-6361/202245367},
  urldate = {2024-10-02},
  abstract = {\emph{Context.{$<$}i/{$>$} In the extremely cold and dark environments of pre-stellar cores, methanol is formed on the surface of interstellar dust grains and released into the gas phase via non-thermal desorption mechanisms. Gaseous methanol constitutes the starting point for the formation of many massive complex organic molecules and is therefore of utmost importance for the build-up of chemical complexity.\emph{Aims.{$<$}i/{$>$} We aim to improve upon a previous model for the prediction of column densities and deuterium fractions of non-deuterated and singly deuterated methanol. Thereby, we try to identify crucial chemical and physical parameters for which the study of deuteration could provide valuable additional constraints.\emph{Methods.{$<$}i/{$>$} We employed a gas-grain chemical code to devise a model that is in agreement with the observed column density and deuterium fraction profiles of the innermost region of the pre-stellar core L1544. For that purpose, we developed a new treatment of reactive desorption, deriving an individual reactive desorption efficiency for every product species in a chemical reaction that depends on the reaction enthalpy and type of the underlying surface. Furthermore, we explored several options to promote the diffusion of hydrogen and deuterium atoms over the surface of interstellar dust grains in order to increase methanol formation.\emph{Results.{$<$}i/{$>$} Our fiducial model employs diffusion via the quantum tunnelling of hydrogen and deuterium atoms, resulting in CH\textsubscript{3{$<$}sub/{$>$}OH and CH\textsubscript{2{$<$}sub/{$>$}DOH column densities that are approximately an order of magnitude lower than the observed values, which is an improvement over the results of the previous model by a factor of 10. The \emph{N{$<$}i/{$>$}(CH\textsubscript{2{$<$}sub/{$>$}DOH)/\emph{N{$<$}i/{$>$}(CH\textsubscript{3{$<$}sub/{$>$}OH) ratio is reproduced within a factor of 1.2 for the centre and 1.8 for the position of the methanol peak. Given the large uncertainties that chemical models typically have, we consider our predictions to be in agreement with the observations. In general, we conclude that a diffusion process with a high diffusion rate needs to be employed to obtain methanol column densities that are in accordance with the observed values. Also, we find that the introduction of abstraction reactions into the methanol formation scheme suppresses deuteration when used in combination with a high diffusion rate.}}}}}}}}}}},
  copyright = {\copyright{} The Authors 2023},
  langid = {english},
  file = {/Users/kmaitreys/Zotero/storage/7FC6RHXT/Riedel et al. - 2023 - Modelling deuterated isotopologues of methanol towards the pre-stellar core L1544.pdf}
}

