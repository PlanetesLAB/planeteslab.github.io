@article{zivickDistinguishingFRGravity2014,
  title = {Distinguishing f({{R}}) Gravity with Cosmic Voids},
  author = {Zivick, P. and Sutter, P. M.},
  year = 2014,
  month = jun,
  journal = {Proceedings of the International Astronomical Union},
  volume = {11},
  number = {S308},
  pages = {589--590},
  issn = {1743-9213, 1743-9221},
  doi = {10.1017/S1743921316010632},
  urldate = {2022-11-21},
  abstract = {We use properties of void populations identified in N -body simulations to forecast the ability of upcoming galaxy surveys to differentiate models of f(R) gravity from {$\Lambda$}CDM cosmology. We analyze simulations designed to mimic the densities, volumes, and clustering statistics of upcoming surveys, using the public VIDE toolkit. We examine void abundances as a basic probe at redshifts 1.0 and 0.4. We find that stronger f(R) coupling strengths produce voids up to {$\sim$} 20\% larger in radius, leading to a significant shift in the void number function. As an initial estimate of the constraining power of voids, we use this change in the number function to forecast a constraint on the coupling strength of {$\Delta$}fR 0 = 10-5 .},
  langid = {english}
}

