@article{singariDETECTIONTHERMALSUNYAEVZELDOVICH2018,
  title = {{{DETECTION OF THE THERMAL SUNYAEV-ZEL}}'{{DOVICH EFFECT FROM VOIDS IN THE LARGE SCALE STRUCTURE}}},
  author = {Singari, Baibhav and Ghosh, Tuhin and Das, Mousumi and Ma, Yin-Zhe and Tanimura, Hideki},
  year = 2018,
  pages = {6},
  abstract = {Although voids are the most underdense regions of our Universe, they contain a population of galaxies that are predominantly low mass, star-forming galaxies. The isolated nature of void galaxies makes them ideal for estimating the thermal Sunyaev-Zel'dovich (tSZ) effect from star formation as cluster environments are avoided. Although the tSZ effect is a small fluctuation on the cosmic microwave background, it can be used to detect hot gas around massive, bright galaxies as well as clusters mainly because stacking a large number of sources makes the signal much stronger. In this study we use a sample of {$\sim$} 20, 000 void galaxies from SDSS DR12 that have masses {$>$} 109 M to estimate the tSZ effect due to star formation in low mass, star-forming galaxies. We report an excess tSZ signal with a significance of 3.5{$\sigma$} up to a radial distance of 16 from the Planck-derived SZ maps. The origin of the emission is the hot circum-galactic medium around the galaxies. But unlike the tSZ signal detected from massive galaxies, the tSZ signal from low mass star-forming galaxies is mainly due to stellar feedback and not active galactic nuclei (AGN) feedback as in massive galaxies.},
  langid = {english}
}

