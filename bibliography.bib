@article{kitchatinovSolarDynamoModel2012,
  title = {Solar {{Dynamo Model}} with {{Diamagnetic Pumping}} and {{Nonlocal Alpha-Effect}}},
  author = {Kitchatinov, L. L. and Olemskoy, S. V.},
  year = 2012,
  month = feb,
  journal = {Solar Physics},
  volume = {276},
  number = {1-2},
  eprint = {1108.3138},
  primaryclass = {astro-ph},
  pages = {3--17},
  issn = {0038-0938, 1573-093X},
  doi = {10.1007/s11207-011-9887-2},
  urldate = {2022-06-22},
  abstract = {A combination of diamagnetic pumping and a nonlocal {$\alpha$}-effect of the Babcock-Leighton type in a solar dynamo model helps to reproduce observations of solar magnetic activity. The period of the solar cycle can be reproduced without reducing magnetic diffusivity in the bulk of the convection zone below the standard mixing-length value of 1013 cm2s-1. The simulated global fields are antisymmetric about the equator and the toroidal-to-poloidal field ratio is about a thousand. The time-latitude diagrams of magnetic fields in the model without meridional flow, however, differ from observations. Only when the meridional flow is included and the {$\alpha$}-effect profile peaking at mid latitudes is applied, can the observational butterfly diagrams be reproduced.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Astrophysics - Solar and Stellar Astrophysics}
}

