  title = {{{NEW EXTENDED DEUTERIUM FRACTIONATION MODEL}}: {{ASSESSMENT AT DENSE ISM CONDITIONS AND SENSITIVITY ANALYSIS}}},
  shorttitle = {{{NEW EXTENDED DEUTERIUM FRACTIONATION MODEL}}},
